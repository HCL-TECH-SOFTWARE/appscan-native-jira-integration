# SCVS-4.18: Prevent lifecycle script execution during install
ignore-scripts=true

# SCAL-PKGDEP-2: Always save exact versions for future installs
save-exact=true
package-lock=true

# SCAL-PKGDEP-2: Restrict dependency sources to registry only
allow-git=none
allow-file=none
allow-remote=none

# SCAL-PKGDEP-3: Reject packages published fewer than 7 days ago
min-release-age=7
